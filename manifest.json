{
  "manifest_version": 2,
  "name": "Phabvanced",
  "version": "0.2.0",
  "description": "Enhanced Phabricator code review: permalink comments, line-level review tracking, and annotation mapping.",
  "permissions": [
    "storage"
  ],
  "browser_action": {
    "default_title": "Phabvanced: Toggle Annotation Panel"
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://phabricator.services.mozilla.com/*"
      ],
      "js": [
        "src/common.js",
        "src/storage.js",
        "src/permalinks.js",
        "src/review-gutter.js",
        "src/annotations.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "phabvanced@vhilla"
    }
  }
}
